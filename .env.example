# Veyra Found - Environment Configuration
# Copy this file to .env and fill in your credentials.
#
# NOTE: Do NOT set SUPABASE_PROJECT_ID here — the Supabase CLI reads it and
# will fail with "Invalid project ref format" if the value is wrong.
# Project ref is configured in supabase/config.toml instead.

# Supabase (client + SSR)
VITE_SUPABASE_URL="https://lyqkzunsqworhvwphsia.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-SUPABASE-ANON-KEY"

# Supabase (server-only)
SUPABASE_URL="https://lyqkzunsqworhvwphsia.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-SUPABASE-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# AI compatibility reports (server-only) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
